{
  "name": "systemlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src harness/src",
    "harness:verify": "npm run lint && tsc -b && npm run arch:check && npm run test",
    "harness": "tsx harness/src/index.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "idb": "^8.0.4",
    "immer": "^11.2.9",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@linear/sdk": "^101.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
